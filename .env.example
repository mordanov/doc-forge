# Authentication (required for HTTP server)
DOCFORGE_USERNAME=admin
DOCFORGE_PASSWORD=changeme123
DOCFORGE_SECRET_KEY=your-very-long-random-secret-key-minimum-32-characters

# Token lifetime in hours (default: 24)
DOCFORGE_TOKEN_TTL_HOURS=24

# AI provider
OPENAI_API_KEY=sk-...

# Image providers (optional)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# Identify your deployment to Wikimedia; use a real contact URL or email.
DOCFORGE_WIKIMEDIA_USER_AGENT=DocForge/1.0 (https://github.com/mordanov/doc-forge)

# Logging
DOCFORGE_LOG_LEVEL=INFO
DOCFORGE_LOG_FORMAT=human

# Server
DOCFORGE_HOST=127.0.0.1
DOCFORGE_PORT=8000

# Cache
DOCFORGE_CACHE_DIR=.docforge/cache
