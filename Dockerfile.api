FROM python:3.13-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-calc \
    fonts-liberation \
    fonts-dejavu-core \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY docforge/ ./docforge/
COPY prompts/ ./prompts/
COPY examples/ ./examples/

RUN pip install --no-cache-dir .

RUN mkdir -p .docforge/uploads .docforge/cache output

EXPOSE 8000

CMD ["docforge", "server", "start", "--host", "0.0.0.0", "--port", "8000", "--upload-dir", "/app/.docforge/uploads", "--output-dir", "/app/output"]
